{
  // Site de Grégoire Muel EI (sites internet) : Cloudflare Worker + mémoire du site (KV). Le nom technique « site-atelier-muel » reste celui du projet Cloudflare.
  "name": "site-atelier-muel",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Mémoire du site (le contenu) : créée toute seule au premier déploiement (wrangler 4.45 ou plus), puis toujours la même.
  "kv_namespaces": [{ "binding": "CONTENU" }],
  // "oui" tant que les textes et les prix ne sont pas validés : bandeau, non indexé, demandes en démonstration.
  "vars": { "MAQUETTE": "oui" }
  // Après l'achat du domaine (zone ajoutée sur Cloudflare) :
  // "routes": [{ "pattern": "nomdedomaine.fr", "custom_domain": true }]
}
