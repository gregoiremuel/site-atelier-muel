{
  // Site de Grégoire Muel EI (sites internet) : Cloudflare Worker + mémoire du site (KV). Le nom technique « site-atelier-muel » reste celui du projet Cloudflare.
  "name": "site-atelier-muel",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Mémoire du site (le contenu) : créée toute seule au premier déploiement (wrangler 4.45 ou plus), puis toujours la même.
  "kv_namespaces": [{ "binding": "CONTENU" }],
  // "oui" tant que les textes et les prix ne sont pas validés : bandeau, non indexé, demandes en démonstration.
  "vars": { "MAQUETTE": "oui" },
  // Copie de sauvegarde du contenu chaque nuit (vers 3 h 17, heure de Paris en hiver).
  "triggers": { "crons": ["17 2 * * *"] },
  // Aperçus de branches (Workers Builds lance « wrangler preview ») : valeurs sûres pour les aperçus, jamais les secrets de production.
  "previews": { "vars": { "MAQUETTE": "oui" } }
  // Copie externe facultative (contenu, photos et vidéos) : créer le stockage R2 (jurisdiction UE possible), puis ajouter
  // "r2_buckets": [{ "binding": "SAUVEGARDE", "bucket_name": "sauvegarde-site-atelier-muel" }]
  // Après l'achat du domaine (zone ajoutée sur Cloudflare) :
  // "routes": [{ "pattern": "sterenncreation.fr", "custom_domain": true }, { "pattern": "www.sterenncreation.fr", "custom_domain": true }]
  // (www est attaché au Worker pour que sa redirection 301 vers le domaine nu fonctionne ; décommenter seulement quand la zone Cloudflare est active,
  // sinon le déploiement échoue. Une fois le domaine validé : MAQUETTE à "non" et workers_dev désactivé — à vérifier dans la doc wrangler.)
}
